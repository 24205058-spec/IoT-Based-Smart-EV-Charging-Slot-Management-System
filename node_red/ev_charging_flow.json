  {
    "id": "comment_academic",
    "type": "comment",
    "z": "tab_ev_sim",
    "name": "ACADEMIC SIMULATION NOTICE",
    "info": "This flow simulates real-time EV charging slot telemetry for academic demonstration.\nNo physical ESP32 hardware is connected.\nThe architecture is structured to allow immediate replacement of simulated nodes with physical ESP32 microcontrollers communicating over Wi-Fi/MQTT.",
    "x": 200,
    "y": 60,
    "wires": []
  },
  {
    "id": "inject_timer_telemetry",
    "type": "inject",
    "z": "tab_ev_sim",
    "name": "Live Tick (Every 5s)",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "5",
    "crontab": "",
    "once": true,
    "onceDelay": "2",
    "topic": "",
    "payload": "",
    "payloadType": "date",
