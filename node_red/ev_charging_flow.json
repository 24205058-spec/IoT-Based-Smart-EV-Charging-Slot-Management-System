      ]
    ]
  },
  {
    "id": "fn_simulate_ev03_telemetry",
    "type": "function",
    "z": "tab_ev_sim",
    "name": "Simulate EV03 Charging Progression",
    "func": "// Retrieve or initialize simulated state in Node-RED context\nlet battery = context.get('ev03_battery') || 67;\nlet energy = context.get('ev03_energy') || 18.4;\nlet power = 7.2;\nlet status = \"CHARGING\";\n\n// Simulate incremental battery charging\nif (battery < 100) {\n    battery += 1;\n    energy += 0.2;\n} else {\n    status = \"COMPLETED\";\n    power = 0.0;\n    // Reset simulation loop after hitting 100%\n    battery = 67;\n    energy = 18.4;\n}\n\nenergy = Math.round(energy * 10) / 10;\n\n// Save updated state\ncontext.set('ev03_battery', battery);\ncontext.set('ev03_energy', energy);\n\nconst payload = {\n    slot_id: \"EV03\",\n    status: status,\n    vehicle_number: \"TN58AB1234\",\n    vehicle_type: \"CAR\",\n    battery_level: battery,\n    charging_power: power,\n    energy_consumed: energy\n};\n\nmsg.payload = payload;\nmsg.headers = { 'Content-Type': 'application/json' };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 450,
    "y": 140,
    "wires": [
      [
        "mqtt_publish_status",
        "http_post_update",
        "debug_telemetry"
      ]
    ]
  },
